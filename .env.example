# magpie-fi — copy to .env and fill in. Keep .env private (chmod 600 .env).

# ── Required ────────────────────────────────────────────────────────────────
# From @BotFather.
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user IDs. Send /id to the bot to find yours.
ALLOWED_TELEGRAM_USER_IDS=123456789

# ── Where things live on the host ───────────────────────────────────────────
# MUSIC_ROOT gets two folders: inbox/ (new, unchecked) and library/ (what Navidrome plays).
# Keep both on ONE disk. DATA_ROOT holds the databases: keep it on a local SSD, not a network share.
MUSIC_ROOT=/srv/music
DATA_ROOT=/srv/magpie-fi/data

# Host user that owns the music files. On Linux/NAS run `id`.
PUID=1000
PGID=1000

# ── Ports ───────────────────────────────────────────────────────────────────
NAVIDROME_PORT=4533
# Review UI, published on 127.0.0.1 only.
CORE_PORT=7331

# ── Behaviour ───────────────────────────────────────────────────────────────
# m4a (best for iPhone/CarPlay) or opus (a bit smaller). Both keep YouTube's original stream.
AUDIO_FORMAT=m4a
# How often the core files new inbox songs, in minutes.
MAGPIE_FILING_INTERVAL_MINUTES=2
# true: after a song is safely written to the library, its inbox copy is deleted.
# This also applies to files you drop into the inbox yourself. Set false to keep originals.
MAGPIE_REMOVE_INBOX_AFTER_FILING=true
MAX_PARALLEL_DOWNLOADS=2
DOWNLOAD_PAUSE_SECONDS=3
MAX_COLLECTION_TRACKS=1000
# Optional: put a Netscape cookies.txt in config/ytdlp/ and set:
# YTDLP_COOKIES_FILE=/config/cookies.txt
YTDLP_COOKIES_FILE=
RECEIVED_STICKER_ID=
LOG_LEVEL=INFO
RUST_LOG=info

# ── Optional identification sources (empty = off) ───────────────────────────
# Strongly recommended: free key from https://acoustid.org/new-application
ACOUSTID_KEY=
AUDD_TOKEN=
# Since 2026 the Spotify app owner needs Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
YOUTUBE_API_KEY=
DISCOGS_TOKEN=
LASTFM_KEY=
THEAUDIODB_KEY=

# ── Images ──────────────────────────────────────────────────────────────────
# Pin releases for a NAS, e.g. MAGPIE_TAG=0.1.0
MAGPIE_TAG=latest
NAVIDROME_TAG=0.64.2
