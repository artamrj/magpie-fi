# magpie-fi settings. Copy to .env and fill in. Keep .env private (chmod 600 .env).
# Empty values mean "off" or "use the default".

# ── Where things live on the host ───────────────────────────────────────────
# MUSIC_ROOT gets inbox/ (drop new music here), library/ (what Navidrome plays)
# and .magpie/trash/. DATA_ROOT holds the databases: keep it on a local SSD,
# not on a network share.
MUSIC_ROOT=/srv/music
DATA_ROOT=/srv/magpie-fi/data

# Host user that owns the music files. On Linux/NAS run `id`.
PUID=1000
PGID=1000

# ── Ports ───────────────────────────────────────────────────────────────────
NAVIDROME_PORT=4533
# magpie's web page, published on 127.0.0.1 only.
MAGPIE_PORT=7331

# ── Behaviour ───────────────────────────────────────────────────────────────
# How often the inbox is checked, in seconds.
MAGPIE_INBOX_CHECK_SECONDS=60
# A file must be unchanged this long before magpie touches it (still copying).
MAGPIE_INBOX_SETTLE_SECONDS=30
# Days that originals stay in MUSIC_ROOT/.magpie/trash.
MAGPIE_TRASH_DAYS=30
# Synced lyrics from LRCLIB, saved next to each song.
MAGPIE_LYRICS=true

# ── Getting music (links pasted in the web page) ────────────────────────────
# m4a (best for iPhone/CarPlay) or opus (a bit smaller). Both keep YouTube's
# original audio stream; nothing is re-encoded.
MAGPIE_AUDIO_FORMAT=m4a
# Songs downloaded at the same time, and the pause after each one.
# Use 1 on a VPS or datacenter IP that YouTube limits.
MAGPIE_MAX_PARALLEL_DOWNLOADS=2
MAGPIE_DOWNLOAD_PAUSE_SECONDS=3
# Largest album or playlist read from one link.
MAGPIE_MAX_COLLECTION_TRACKS=1000
# If YouTube asks you to sign in, put a Netscape-format cookies.txt in
# config/ytdlp/ (magpie uses it automatically).

# ── Phone and Telegram Mini App (optional) ──────────────────────────────────
# The web page's public HTTPS address, e.g. https://magpie.your-tailnet.ts.net
# (Tailscale Funnel) or https://magpie.example.com (Cloudflare Tunnel, below).
# Needs the Telegram settings: the bot is how you log in.
MAGPIE_PUBLIC_URL=
# Only for the Cloudflare Tunnel helper (docker compose --profile tunnel up -d).
CLOUDFLARE_TUNNEL_TOKEN=

# ── Identification sources (empty = off) ────────────────────────────────────
# Strongly recommended: free key from https://acoustid.org/new-application
MAGPIE_ACOUSTID_KEY=
MAGPIE_AUDD_TOKEN=
# Since 2026 the Spotify app owner needs Premium.
MAGPIE_SPOTIFY_CLIENT_ID=
MAGPIE_SPOTIFY_CLIENT_SECRET=
MAGPIE_SOUNDCLOUD_CLIENT_ID=
MAGPIE_SOUNDCLOUD_CLIENT_SECRET=
MAGPIE_YOUTUBE_API_KEY=
MAGPIE_DISCOGS_TOKEN=
MAGPIE_LASTFM_KEY=
MAGPIE_THEAUDIODB_KEY=

RUST_LOG=info

# ── Images ──────────────────────────────────────────────────────────────────
# Pin a release for a NAS, e.g. MAGPIE_TAG=0.1.0
MAGPIE_TAG=latest
NAVIDROME_TAG=0.64.2

# ── Telegram (optional) ─────────────────────────────────────────────────────
# A bot from @BotFather. Owners are Telegram user IDs (send /id to the bot).
# Owners can invite guests with /guests.
MAGPIE_TELEGRAM_BOT_TOKEN=
MAGPIE_TELEGRAM_OWNERS=
